{
  "name": "@hraness/accounts-cli",
  "version": "0.1.0",
  "description": "CLI authentication SDK for Hraness Accounts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/accounts-cli.git"
  },
  "homepage": "https://github.com/hraness/accounts-cli#readme",
  "bugs": {
    "url": "https://github.com/hraness/accounts-cli/issues"
  },
  "keywords": [
    "accounts",
    "authentication",
    "cli",
    "oauth",
    "oidc",
    "typescript"
  ],
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@hraness/suite-accounts": "github:hraness/suite-accounts#21424ee08eb41929c7290cfddfdb479923fb6ba5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
